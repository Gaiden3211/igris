# Copy to .env.local for local development. Never commit real values.

# Supabase: Project Settings -> API. The secret key bypasses row-level security, keep it server-side only.
SUPABASE_URL=https://aeycforegdtnshjszpdg.supabase.co
SUPABASE_SECRET_KEY=

# Radium (OpenAI-compatible). The backup key is used automatically if the primary fails.
RADIUM_BASE_URL=https://api.radium.cloud/v1
RADIUM_MODEL=tycho-1.0
RADIUM_API_KEY=
RADIUM_API_KEY_BACKUP=

# Any long random string. Used to hash visitor addresses for rate limiting.
IP_HASH_SALT=

# Optional limit overrides (defaults shown).
# LIMIT_PER_MINUTE=5
# LIMIT_PER_DAY=30
# LIMIT_PER_IP_DAY=90
# LIMIT_GLOBAL_PER_DAY=600
# LIMIT_INPUT_CHARS=2000
# LIMIT_OUTPUT_TOKENS=1200
# Extra room for a reasoning model's hidden thinking (a ceiling, not billed if unused). 0 for non-reasoning models.
# Use tycho-1.0: hal-1.0 and clarke-1.0 can spend the whole budget thinking and return no text (see docs/AGENT.md).
# LIMIT_REASONING_TOKENS=2000
