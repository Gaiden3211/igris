# Copy to .env.local for local development. Never commit real values.

# Supabase: Project Settings -> API. The secret key bypasses row-level security, keep it server-side only.
SUPABASE_URL=https://aeycforegdtnshjszpdg.supabase.co
SUPABASE_SECRET_KEY=

# Radium (OpenAI-compatible). The backup key is used automatically if the primary fails.
RADIUM_BASE_URL=https://api.radium.cloud/v1
RADIUM_MODEL=clarke-1.0
# Bound hidden reasoning so short tasks leave room for the visible answer.
RADIUM_REASONING_EFFORT=low
RADIUM_API_KEY=
RADIUM_API_KEY_BACKUP=

# Any long random string. Used to hash visitor addresses for rate limiting.
IP_HASH_SALT=

# Server-side quota switch. Keep true in production; use false for local testing.
LIMITS_ENABLED=true
# Optional limit overrides (defaults shown).
# LIMIT_PER_MINUTE=5
# LIMIT_PER_DAY=50
# LIMIT_PER_IP_DAY=90
# LIMIT_GLOBAL_PER_DAY=600
# LIMIT_INPUT_CHARS=2000
# LIMIT_OUTPUT_TOKENS=2000
# Full model call/stream and whole chat/comparison request, in milliseconds.
# LIMIT_MODEL_TIMEOUT_MS=30000
# LIMIT_REQUEST_TIMEOUT_MS=60000
# Extra room for a reasoning model's hidden thinking (a ceiling, not billed if unused). 0 for non-reasoning models.
# LIMIT_REASONING_TOKENS=2000

# Allow live lookups in the public NASA NTRS repository during chat research.
PUBLIC_RESEARCH_ENABLED=true
